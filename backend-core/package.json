{
  "name": "backend-core",
  "version": "1.0.0",
  "description": "Core API Service for AI-powered Project Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/ingestion_and_generation.test.ts",
    "test:planning": "tsx --test tests/sprint_planning.test.ts",
    "test:slug": "tsx --test tests/slug_and_routing.test.ts",
    "test:invitations": "tsx --test tests/invitations_and_notifications.test.ts",
    "test:all": "tsx --test tests/ingestion_and_generation.test.ts tests/sprint_planning.test.ts tests/slug_and_routing.test.ts tests/invitations_and_notifications.test.ts",
    "test:pipeline": "node scripts/verify-pipeline.js",
    "test:ai-discussion": "node scripts/test-ai-ticket-discussion.js",
    "test:roles-board": "node scripts/test-roles-and-dynamic-board.js",
    "test:multi-assignee": "node scripts/test-multi-assignee.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.1",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
