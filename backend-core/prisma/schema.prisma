datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  OWNER     @map("owner")
  MANAGER   @map("manager")
  DEVELOPER @map("developer")
  EDITOR    @map("editor")

  @@map("project_member_role")
}

enum TicketStatus {
  TODO        @map("To Do")
  IN_PROGRESS @map("In Progress")
  DONE        @map("Done")

  @@map("ticket_status")
}

enum TicketPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")

  @@map("ticket_priority")
}

enum TicketType {
  FEATURE     @map("Feature")
  BUG         @map("Bug")
  TASK        @map("Task")
  IMPROVEMENT @map("Improvement")

  @@map("ticket_type")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedProjects   Project[]        @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  assignedTickets Ticket[]         @relation("TicketAssignee")
  reportedTickets Ticket[]         @relation("TicketReporter")
  comments        Comment[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  ownerId     String   @map("owner_id")
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members ProjectMember[]
  boards  Board[]
  tickets Ticket[]

  @@map("projects")
}

model ProjectMember {
  id         String      @id @default(uuid())
  projectId  String      @map("project_id")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectRole @default(DEVELOPER)
  invitedAt  DateTime    @default(now()) @map("invited_at")
  acceptedAt DateTime?   @map("accepted_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

model Board {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   @default("Main Board")
  createdAt DateTime @default(now()) @map("created_at")

  tickets   Ticket[]

  @@map("boards")
}

model Ticket {
  id          String         @id @default(uuid())
  boardId     String         @map("board_id")
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  projectId   String         @map("project_id")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  status      TicketStatus   @default(TODO)
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(TASK)
  assigneeId  String?        @map("assignee_id")
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  String?        @map("reporter_id")
  reporter    User?          @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  comments    Comment[]
  embedding   TicketEmbedding?

  @@index([projectId])
  @@index([boardId])
  @@index([status])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ticketId])
  @@map("comments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model TicketEmbedding {
  id        String                      @id @default(uuid())
  ticketId  String                      @unique @map("ticket_id")
  ticket    Ticket                      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now()) @map("created_at")

  @@map("ticket_embeddings")
}
