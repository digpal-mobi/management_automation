datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  OWNER     @map("owner")
  MANAGER   @map("manager")
  DEVELOPER @map("developer")
  EDITOR    @map("editor")

  @@map("project_member_role")
}

enum TicketStatus {
  TODO        @map("To Do")
  IN_PROGRESS @map("In Progress")
  DONE        @map("Done")

  @@map("ticket_status")
}

enum TicketPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")

  @@map("ticket_priority")
}

enum TicketType {
  FEATURE     @map("Feature")
  BUG         @map("Bug")
  TASK        @map("Task")
  IMPROVEMENT @map("Improvement")

  @@map("ticket_type")
}

enum DocumentProcessingStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("document_processing_status")
}

enum FeatureReviewStatus {
  PROPOSED @map("proposed")
  ACCEPTED @map("accepted")
  DEFERRED @map("deferred")

  @@map("feature_review_status")
}

enum AiProcessingStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
  SKIPPED    @map("skipped")

  @@map("ai_processing_status")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedProjects   Project[]        @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  assignedTickets   Ticket[]            @relation("TicketAssignee")
  ticketAssignments TicketAssignee[]
  reportedTickets   Ticket[]            @relation("TicketReporter")
  comments          Comment[]
  refreshTokens     RefreshToken[]
  userRoles         UserRole[]
  invitationsSent     ProjectInvitation[] @relation("InvitationInviter")
  invitationsReceived ProjectInvitation[] @relation("InvitationRecipient")
  notifications       Notification[]

  @@map("users")
}

model Project {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  description          String?  @db.Text
  goals                String?  @db.Text
  targetUsers          String?  @map("target_users") @db.Text
  techStack            String?  @map("tech_stack") @db.Text
  businessRequirements String?  @map("business_requirements") @db.Text
  technicalConstraints String?  @map("technical_constraints") @db.Text
  knownDependencies    String?  @map("known_dependencies") @db.Text
  targetReleaseDate    String?  @map("target_release_date")
  additionalNotes      String?  @map("additional_notes") @db.Text
  ownerId              String   @map("owner_id")
  owner                User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members            ProjectMember[]
  boards             Board[]
  tickets            Ticket[]
  documents          ProjectDocument[]
  analysis           ProjectAnalysis?
  features           ProjectFeature[]
  documentChunks     DocumentChunk[]
  userRoles          UserRole[]
  sprintCapacity     Int?                  @default(30) @map("sprint_capacity")
  sprintPlans        SprintPlan[]
  ticketDependencies TicketDependency[]
  slugRedirects      ProjectSlugRedirect[]
  invitations        ProjectInvitation[]
  notifications      Notification[]

  @@map("projects")
}

model ProjectMember {
  id         String      @id @default(uuid())
  projectId  String      @map("project_id")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectRole @default(DEVELOPER)
  invitedAt  DateTime    @default(now()) @map("invited_at")
  acceptedAt DateTime?   @map("accepted_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectDocument {
  id            String                   @id @default(uuid())
  projectId     String                   @map("project_id")
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename      String
  fileSize      Int                      @map("file_size")
  fileFormat    String                   @map("file_format")
  mimeType      String                   @map("mime_type")
  status        DocumentProcessingStatus @default(PENDING)
  errorMessage  String?                  @map("error_message") @db.Text
  extractedText String?                  @map("extracted_text") @db.Text
  metadata      Json?
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@index([projectId])
  @@map("project_documents")
}

model DocumentChunk {
  id            String          @id @default(uuid())
  documentId    String          @map("document_id")
  document      ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId     String          @map("project_id")
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunkText     String          @map("chunk_text") @db.Text
  location      String?
  sourceHeading String?         @map("source_heading")
  order         Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([projectId])
  @@index([documentId])
  @@map("document_chunks")
}

model ProjectAnalysis {
  id                       String   @id @default(uuid())
  projectId                String   @unique @map("project_id")
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overview                 String?  @db.Text
  functionalRequirements   Json?    @map("functional_requirements")
  nonFunctionalRequirements Json?   @map("non_functional_requirements")
  businessRules            Json?    @map("business_rules")
  technicalRequirements    Json?    @map("technical_requirements")
  milestones               Json?
  openQuestions            Json?    @map("open_questions")
  brief                    Json?    @map("brief")
  coverageReport           Json?    @map("coverage_report")
  sprintSchedule           Json?    @map("sprint_schedule")
  candidateReconciliations Json?    @map("candidate_reconciliations")
  status                   String   @default("COMPLETED")
  analyzedAt               DateTime @default(now()) @map("analyzed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("project_analyses")
}

model ProjectFeature {
  id                         String              @id @default(uuid())
  projectId                  String              @map("project_id")
  project                    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                       String
  description                String              @db.Text
  module                     String              @default("Core")
  businessValue              String?             @map("business_value") @db.Text
  relatedRequirements        Json?               @map("related_requirements")
  dependencies               Json?
  suggestedPriority          TicketPriority      @default(MEDIUM) @map("suggested_priority")
  constraints                String?             @db.Text
  sourceReferences           Json?               @map("source_references")
  sprint                     String?
  targetDate                 String?             @map("target_date")
  sourceCandidateIds         Json?               @map("source_candidate_ids")
  proposedAcceptanceCriteria Json?               @map("proposed_acceptance_criteria")
  status                     FeatureReviewStatus @default(PROPOSED)
  isAiGenerated              Boolean             @default(true) @map("is_ai_generated")
  order                      Int                 @default(0)
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  tickets Ticket[]

  @@index([projectId])
  @@index([status])
  @@index([sprint])
  @@map("project_features")
}

model Board {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   @default("Main Board")
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]
  columns BoardColumn[]

  @@map("boards")
}

model Ticket {
  id                 String          @id @default(uuid())
  boardId            String          @map("board_id")
  board              Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId           String?         @map("column_id")
  column             BoardColumn?    @relation(fields: [columnId], references: [id], onDelete: SetNull)
  projectId          String          @map("project_id")
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId          String?         @map("feature_id")
  feature            ProjectFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  sourceCandidateId  String?         @map("source_candidate_id")
  sprint             String?
  module             String?
  ownershipRole      String?         @map("ownership_role")
  sourceReferences   Json?           @map("source_references")
  definitionOfDone   Json?           @map("definition_of_done")
  title              String
  description        String?         @db.Text
  status             TicketStatus    @default(TODO)
  priority           TicketPriority  @default(MEDIUM)
  type               TicketType      @default(TASK)
  acceptanceCriteria Json?           @map("acceptance_criteria")
  technicalNotes     String?         @map("technical_notes") @db.Text
  prChecklist        Json?           @map("pr_checklist")
  storyPoints          Int?               @map("story_points")
  executionOrder       Int                @default(0) @map("execution_order")
  isLocked             Boolean            @default(false) @map("is_locked")
  assigneeId           String?            @map("assignee_id")
  assignee             User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignees            TicketAssignee[]
  reporterId           String?            @map("reporter_id")
  reporter             User?              @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  comments             Comment[]
  embedding            TicketEmbedding?
  dependenciesOutgoing TicketDependency[] @relation("DependencySource")
  dependenciesIncoming TicketDependency[] @relation("DependencyTarget")

  @@index([projectId])
  @@index([boardId])
  @@index([columnId])
  @@index([featureId])
  @@index([sourceCandidateId])
  @@index([sprint])
  @@index([status])
  @@map("tickets")
}

model TicketAssignee {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_assignees")
}

model Comment {
  id                 String              @id @default(uuid())
  ticketId           String              @map("ticket_id")
  ticket             Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId             String?             @map("user_id")
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content            String              @db.Text
  isAi               Boolean             @default(false) @map("is_ai")
  authorName         String?             @map("author_name")
  parentCommentId    String?             @map("parent_comment_id")
  parentComment      Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies            Comment[]           @relation("CommentReplies")
  aiProcessingStatus AiProcessingStatus? @default(COMPLETED) @map("ai_processing_status")
  aiMetadata         Json?               @map("ai_metadata")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([parentCommentId])
  @@map("comments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model TicketEmbedding {
  id        String                      @id @default(uuid())
  ticketId  String                      @unique @map("ticket_id")
  ticket    Ticket                      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now()) @map("created_at")

  @@map("ticket_embeddings")
}

model BoardColumn {
  id          String       @id @default(uuid())
  boardId     String       @map("board_id")
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  description String?      @db.Text
  position    Int          @default(0)
  category    TicketStatus @default(TODO)
  isDefault   Boolean      @default(false) @map("is_default")
  color       String?
  wipLimit    Int?         @default(0) @map("wip_limit")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tickets     Ticket[]

  @@index([boardId])
  @@index([boardId, position])
  @@map("board_columns")
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?          @db.Text
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?          @db.Text
  resource    String
  action      String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  roles       RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([roleId])
  @@index([projectId])
  @@map("user_roles")
}

model TicketDependency {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTicketId String   @map("source_ticket_id")
  sourceTicket   Ticket   @relation("DependencySource", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicketId String   @map("target_ticket_id")
  targetTicket   Ticket   @relation("DependencyTarget", fields: [targetTicketId], references: [id], onDelete: Cascade)
  type           String   @default("BLOCKS") // BLOCKS, RELIES_ON, INTEGRATES_WITH
  isInferred     Boolean  @default(false) @map("is_inferred")
  reason         String?  @db.Text
  confidence     Float?   @default(1.0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceTicketId, targetTicketId])
  @@index([projectId])
  @@index([sourceTicketId])
  @@index([targetTicketId])
  @@map("ticket_dependencies")
}

model SprintPlan {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version             Int       @default(1)
  status              String    @default("PROPOSED") // PROPOSED, APPROVED, SUPERSEDED, REJECTED
  title               String    @default("Sprint Implementation Plan")
  summary             String?   @db.Text
  sprintAllocations   Json      @map("sprint_allocations") // Detailed sprint-by-sprint allocations
  dependencies        Json?     // Snapshot of dependency graph used
  unscheduledTickets  Json?     @map("unscheduled_tickets") // Unscheduled backlog with explicit reasons
  criticalPath        Json?     @map("critical_path") // Critical path tickets & sequence
  capacitySettings    Json?     @map("capacity_settings") // Capacity per sprint, role limits
  validationReport    Json?     @map("validation_report") // Validation report, warnings, metrics
  changeSummary       Json?     @map("change_summary") // Diff vs previous approved plan
  planningAssumptions Json?     @map("planning_assumptions") // Extracted & user planning assumptions
  isApproved          Boolean   @default(false) @map("is_approved")
  approvedAt          DateTime? @map("approved_at")
  approvedById        String?   @map("approved_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([projectId, version])
  @@index([status])
  @@map("sprint_plans")
}

enum InvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")

  @@map("invitation_status")
}

enum NotificationType {
  PROJECT_INVITATION          @map("project_invitation")
  PROJECT_INVITATION_ACCEPTED @map("project_invitation_accepted")
  PROJECT_INVITATION_DECLINED @map("project_invitation_declined")
  SYSTEM                      @map("system")

  @@map("notification_type")
}

model ProjectInvitation {
  id             String           @id @default(uuid())
  projectId      String           @map("project_id")
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedUserId  String?          @map("invited_user_id")
  invitedUser    User?            @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  recipientEmail String           @map("recipient_email")
  inviterId      String           @map("inviter_id")
  inviter        User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  role           ProjectRole
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  respondedAt    DateTime?        @map("responded_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  notifications Notification[]

  @@index([projectId, status])
  @@index([invitedUserId, status])
  @@index([recipientEmail, status])
  @@index([inviterId])
  @@map("project_invitations")
}

model Notification {
  id           String             @id @default(uuid())
  recipientId  String             @map("recipient_id")
  recipient    User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  message      String             @db.Text
  projectId    String?            @map("project_id")
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitationId String?            @map("invitation_id")
  invitation   ProjectInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  readAt       DateTime?          @map("read_at")
  metadata     Json?
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([invitationId, type, recipientId])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([projectId])
  @@index([invitationId])
  @@map("notifications")
}

model ProjectSlugRedirect {
  id        String   @id @default(uuid())
  slug      String   @unique
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([projectId])
  @@map("project_slug_redirects")
}

