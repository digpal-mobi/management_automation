datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  OWNER     @map("owner")
  MANAGER   @map("manager")
  DEVELOPER @map("developer")
  EDITOR    @map("editor")

  @@map("project_member_role")
}

enum TicketStatus {
  TODO        @map("To Do")
  IN_PROGRESS @map("In Progress")
  DONE        @map("Done")

  @@map("ticket_status")
}

enum TicketPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")

  @@map("ticket_priority")
}

enum TicketType {
  FEATURE     @map("Feature")
  BUG         @map("Bug")
  TASK        @map("Task")
  IMPROVEMENT @map("Improvement")

  @@map("ticket_type")
}

enum DocumentProcessingStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("document_processing_status")
}

enum FeatureReviewStatus {
  PROPOSED @map("proposed")
  ACCEPTED @map("accepted")
  DEFERRED @map("deferred")

  @@map("feature_review_status")
}

enum AiProcessingStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
  SKIPPED    @map("skipped")

  @@map("ai_processing_status")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedProjects   Project[]        @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  assignedTickets Ticket[]         @relation("TicketAssignee")
  reportedTickets Ticket[]         @relation("TicketReporter")
  comments        Comment[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model Project {
  id                   String   @id @default(uuid())
  name                 String
  description          String?  @db.Text
  goals                String?  @db.Text
  targetUsers          String?  @map("target_users") @db.Text
  techStack            String?  @map("tech_stack") @db.Text
  businessRequirements String?  @map("business_requirements") @db.Text
  technicalConstraints String?  @map("technical_constraints") @db.Text
  knownDependencies    String?  @map("known_dependencies") @db.Text
  targetReleaseDate    String?  @map("target_release_date")
  additionalNotes      String?  @map("additional_notes") @db.Text
  ownerId              String   @map("owner_id")
  owner                User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members        ProjectMember[]
  boards         Board[]
  tickets        Ticket[]
  documents      ProjectDocument[]
  analysis       ProjectAnalysis?
  features       ProjectFeature[]
  documentChunks DocumentChunk[]

  @@map("projects")
}

model ProjectMember {
  id         String      @id @default(uuid())
  projectId  String      @map("project_id")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectRole @default(DEVELOPER)
  invitedAt  DateTime    @default(now()) @map("invited_at")
  acceptedAt DateTime?   @map("accepted_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectDocument {
  id            String                   @id @default(uuid())
  projectId     String                   @map("project_id")
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename      String
  fileSize      Int                      @map("file_size")
  fileFormat    String                   @map("file_format")
  mimeType      String                   @map("mime_type")
  status        DocumentProcessingStatus @default(PENDING)
  errorMessage  String?                  @map("error_message") @db.Text
  extractedText String?                  @map("extracted_text") @db.Text
  metadata      Json?
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@index([projectId])
  @@map("project_documents")
}

model DocumentChunk {
  id            String          @id @default(uuid())
  documentId    String          @map("document_id")
  document      ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId     String          @map("project_id")
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunkText     String          @map("chunk_text") @db.Text
  location      String?
  sourceHeading String?         @map("source_heading")
  order         Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([projectId])
  @@index([documentId])
  @@map("document_chunks")
}

model ProjectAnalysis {
  id                       String   @id @default(uuid())
  projectId                String   @unique @map("project_id")
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overview                 String?  @db.Text
  functionalRequirements   Json?    @map("functional_requirements")
  nonFunctionalRequirements Json?   @map("non_functional_requirements")
  businessRules            Json?    @map("business_rules")
  technicalRequirements    Json?    @map("technical_requirements")
  milestones               Json?
  openQuestions            Json?    @map("open_questions")
  status                   String   @default("COMPLETED")
  analyzedAt               DateTime @default(now()) @map("analyzed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("project_analyses")
}

model ProjectFeature {
  id                  String              @id @default(uuid())
  projectId           String              @map("project_id")
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  description         String              @db.Text
  module              String              @default("Core")
  businessValue       String?             @map("business_value") @db.Text
  relatedRequirements Json?               @map("related_requirements")
  dependencies        Json?
  suggestedPriority   TicketPriority      @default(MEDIUM) @map("suggested_priority")
  constraints         String?             @db.Text
  sourceReferences    Json?               @map("source_references")
  status              FeatureReviewStatus @default(PROPOSED)
  isAiGenerated       Boolean             @default(true) @map("is_ai_generated")
  order               Int                 @default(0)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  tickets Ticket[]

  @@index([projectId])
  @@index([status])
  @@map("project_features")
}

model Board {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   @default("Main Board")
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]

  @@map("boards")
}

model Ticket {
  id                 String          @id @default(uuid())
  boardId            String          @map("board_id")
  board              Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  projectId          String          @map("project_id")
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId          String?         @map("feature_id")
  feature            ProjectFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  title              String
  description        String?         @db.Text
  status             TicketStatus    @default(TODO)
  priority           TicketPriority  @default(MEDIUM)
  type               TicketType      @default(TASK)
  acceptanceCriteria Json?           @map("acceptance_criteria")
  technicalNotes     String?         @map("technical_notes") @db.Text
  prChecklist        Json?           @map("pr_checklist")
  storyPoints        Int?            @map("story_points")
  assigneeId         String?         @map("assignee_id")
  assignee           User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId         String?         @map("reporter_id")
  reporter           User?           @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  comments  Comment[]
  embedding TicketEmbedding?

  @@index([projectId])
  @@index([boardId])
  @@index([featureId])
  @@index([status])
  @@map("tickets")
}

model Comment {
  id                 String              @id @default(uuid())
  ticketId           String              @map("ticket_id")
  ticket             Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId             String?             @map("user_id")
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content            String              @db.Text
  isAi               Boolean             @default(false) @map("is_ai")
  authorName         String?             @map("author_name")
  parentCommentId    String?             @map("parent_comment_id")
  parentComment      Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies            Comment[]           @relation("CommentReplies")
  aiProcessingStatus AiProcessingStatus? @default(COMPLETED) @map("ai_processing_status")
  aiMetadata         Json?               @map("ai_metadata")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([parentCommentId])
  @@map("comments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model TicketEmbedding {
  id        String                      @id @default(uuid())
  ticketId  String                      @unique @map("ticket_id")
  ticket    Ticket                      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now()) @map("created_at")

  @@map("ticket_embeddings")
}
