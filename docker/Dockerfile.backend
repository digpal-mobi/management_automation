FROM node:20-slim

WORKDIR /app

RUN apt-get update -y && apt-get upgrade -y && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

COPY . .

RUN npx prisma generate --schema prisma/schema.prisma
RUN npm run build

EXPOSE 3001

CMD ["npm", "start"]
