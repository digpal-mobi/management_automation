# ==========================================================
# TaskPulse Root Environment Reference
# ==========================================================

# 1. Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pm_ai_db?schema=public"

# 2. Service Endpoints
AI_SERVICE_URL="http://localhost:5001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# 3. LLM Configuration (Groq Cloud)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
GROQ_PROMPT_GUARD_MODEL="meta-llama/llama-prompt-guard-2-86m"
GROQ_SAFEGUARD_MODEL="openai/gpt-oss-safeguard-20b"

# 4. Auth Secrets (Min 32 characters)
JWT_ACCESS_SECRET="[ENCRYPTION_KEY]"
JWT_REFRESH_SECRET="[ENCRYPTION_KEY]"
